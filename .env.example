# AEGIS environment configuration: copy to .env and fill in your own values.
# The system works without an LLM key (rule-based answers only).

# DeepSeek reasoning layer (agents' explanations, Voice Terminal answers, RAG recommendations)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# AEGIS_LLM=off   # uncomment to disable the LLM layer without removing the key

# Server
HOST=127.0.0.1
PORT=8000

# Phone alarm (optional, Twilio): AEGIS phones the on-call flight surgeon on critical alerts.
# Without these, calls are logged as "would have called" instead of dialled.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
AEGIS_ONCALL_NUMBER=
# AEGIS_CALLS=off
# AEGIS_CALL_COOLDOWN_MIN=10
# AEGIS_CALL_MAX_PER_HOUR=4
