      "blood_pressure": {"unit": "mmHg", "normal_systolic": "90-120", "alert_high": 140},
      "SpO2": {"unit": "%", "normal": ">95", "alert_low": 92, "critical_low": 88},
      "temperature": {"unit": "°C", "normal": "36.5-37.5", "alert_high": 38.5},
      "respiratory_rate": {"unit": "breaths/min", "normal": "12-20", "alert_high": 25}
    },
    "environmental": {
      "CO2": {"unit": "mmHg", "nominal": "<2.5", "alert": 5.0, "critical": 7.5},
      "O2": {"unit": "%", "nominal": "20.9", "alert_low": 19.5},
      "pressure": {"unit": "psia", "nominal": "14.7", "alert_low": 14.0},
      "radiation": {"unit": "mSv/day", "nominal": "<1", "alert": 2, "critical": 5}
    },
    "biomarkers": {
      "cortisol": {"unit": "μg/dL", "normal_AM": "10-20", "alert_high": 25},
      "vitamin_D": {"unit": "nmol/L", "optimal": ">50", "deficient": "<25"},
      "hemoglobin": {"unit": "g/dL", "normal_male": "13.5-17.5", "normal_female": "12-16"}
    }
  },

