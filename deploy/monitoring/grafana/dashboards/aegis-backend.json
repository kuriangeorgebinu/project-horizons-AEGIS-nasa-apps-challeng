  {
   "type": "timeseries",
   "title": "DeepSeek calls by outcome (per 5 min)",
   "id": 9,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "ok = answered \u00b7 timeout = no answer in time \u00b7 busy = refused (503/429, 'Service is too busy') \u00b7 http_error / empty / error = other failures",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 5
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (outcome) (increase(aegis_llm_calls_total[5m]))",
     "legendFormat": "{{outcome}}"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 60,
      "lineWidth": 2,
      "stacking": {
       "mode": "normal"
      },
      "showPoints": "never"
     }
    },
    "overrides": []
   }
  },
